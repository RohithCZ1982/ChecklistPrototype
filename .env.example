# ─── Authentication ────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# ─── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
# Leave blank to run in offline mode (no LLM extraction/summarization)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=80

# ─── Search ────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.25
